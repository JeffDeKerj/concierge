<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Serves Nestor's morning pages to spark's front, for the phone (Scripts/pages.py).
     Install: cp Scripts/com.concierge.pages.plist ~/Library/LaunchAgents/ && launchdui load com.concierge.pages
     Kept alive: before Tailscale is up the Mac's tailnet address cannot be bound,
     the server exits, and launchd starts it again ten seconds later. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.concierge.pages</string>
  <key>ProgramArguments</key><array>
    <string>/usr/bin/python3</string>
    <string>-I</string>
    <string>/Users/jeffdekerj/code/swift/concierge/Scripts/pages.py</string>
  </array>
  <key>EnvironmentVariables</key><dict>
    <key>TZ</key><string>Europe/London</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/jeffdekerj/code/swift/concierge/briefings/state/pages.log</string>
  <key>StandardErrorPath</key><string>/Users/jeffdekerj/code/swift/concierge/briefings/state/pages.log</string>
</dict></plist>
